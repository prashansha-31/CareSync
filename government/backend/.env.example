# CareSync Government Admin Backend Environment Variables

# API Settings
PROJECT_NAME="CareSync Government Admin API"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:4173"]

# Firebase Configuration
# Place your downloaded Firebase service account key in this backend root folder
FIREBASE_CREDENTIALS_PATH="serviceAccountKey.json"
FIREBASE_PROJECT_ID="caresync-government-portal"
FIREBASE_STORAGE_BUCKET="caresync-government-portal.appspot.com"

# Set to True to allow the backend to run in local mock mode without credentials
USE_MOCK_FIREBASE_IF_NO_CREDS=True
