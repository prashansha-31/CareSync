rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isGovernmentAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'Government Administrator' ||
        request.auth.token.role == 'Chief Medical Officer' ||
        request.auth.token.role == 'Senior Healthcare Regulator' ||
        request.auth.token.email.matches('.*@health[.]gov[.]in$')
      );
    }

    // Hospitals collection: Public read, government write/update
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow create: if isGovernmentAdmin() || request.auth != null;
      allow update, delete: if isGovernmentAdmin();
    }

    // Complaints collection: Anyone can create a complaint, only government can update/view all
    match /complaints/{complaintId} {
      allow create: if true;
      allow read, update, delete: if isGovernmentAdmin();
    }

    // Announcements collection: Public read for published advisories, government manage
    match /announcements/{announcementId} {
      allow read: if resource.data.status == 'Published' || isGovernmentAdmin();
      allow write: if isGovernmentAdmin();
    }

    // Staff directory: Government personnel only
    match /staff/{staffId} {
      allow read, write: if isGovernmentAdmin();
    }

    // Immutable regulatory activity logs: Read only for authorized personnel, append-only
    match /activity_logs/{logId} {
      allow read: if isGovernmentAdmin();
      allow create: if isGovernmentAdmin();
      allow update, delete: if false; // Audit logs cannot be mutated or deleted
    }
  }
}
